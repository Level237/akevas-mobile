{
  "expo": {
    "name": "akevas",
    "slug": "akevas",
    "version": "1.0.0",
    "cli": {
      "appVersionSource": "remote"
    },
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "akevas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.level.akevas",
      "associatedDomains": [
        "applinks:akevas.com"
      ],
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.level.akevas", 
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#E6F4FE"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "akevas.com",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "akevas.com",
              "pathPrefix": "/produit"
            },
            {
              "scheme": "akevas",
              "host": "shop"
            },
            {
              "scheme": "akevas",
              "host": "produit"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8cb48b37-019c-4cc8-8376-b2a9fc6df449"
      }
    },
    "owner": "martindev237"
  }
}